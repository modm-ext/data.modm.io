                  <name>DELAY_1CYCLE_5</name>
                  <description>ADC multimode delay between two sampling phases: 1.5 ADC clock cycle for all resolution</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_2CYCLES_5</name>
                  <description>ADC multimode delay between two sampling phases: 2.5 ADC clock cycles for all resolution</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_3CYCLES_5</name>
                  <description>ADC multimode delay between two sampling phases: 3.5 ADC clock cycles for all resolution</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_4CYCLES_5</name>
                  <description>ADC multimode delay between two sampling phases: 4.5 ADC clock cycles for 16, 14, 12 or 10 bits resolution</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_4CYCLES_5_8_BITS</name>
                  <description>ADC multimode delay between two sampling phases: 4.5 ADC clock cycles for 8 bits resolution</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_5CYCLES_5</name>
                  <description>ADC multimode delay between two sampling phases: 5.5 ADC clock cycles for 16, 14, 12 bits resolution</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_6CYCLES</name>
                  <description>ADC multimode delay between two sampling phases: 6 ADC clock cycles for 10 or 8 bits resolution</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DELAY_6CYCLES_5</name>
                  <description>ADC multimode delay between two sampling phases: 6.5 ADC clock cycles for 16 or 14 bits resolution</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DAMDF</name>
              <description>Dual ADC mode Data format</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EACH_ADC</name>
                  <description>ADC multimode group regular conversions are transferred by DMA: each ADC uses its own DMA channel, with its individual DMA transfer settings</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RES_32_10B</name>
                  <description>ADC multimode group regular conversions are transferred by DMA, one DMA channel for both ADC (DMA of ADC master). Setting for ADC resolution of 32 (16x2) down to 10 bits</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RES_8B</name>
                  <description>ADC multimode group regular conversions are transferred by DMA, one DMA channel for both ADC (DMA of ADC master). Setting for ADC resolution of 8 bits</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
