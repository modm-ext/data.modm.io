                  <description>ADC group injected conversion trigger from external IP: external interrupt line 15. Trigger edge set to rising edge (default setting).</description>
                  <value>6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>JEXTTRIG</name>
              <description>ADC group injected external trigger enable</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXTSEL</name>
