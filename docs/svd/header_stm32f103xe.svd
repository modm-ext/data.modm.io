                </enumeratedValue>
                <enumeratedValue>
                  <name>EXT_TIM4_CH4</name>
                  <description>ADC group regular conversion trigger from external IP: TIM4 channel 4 event (capture compare: input capture or output capture). Trigger edge set to rising edge (default setting).</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXT_EXTI_LINE11</name>
                  <description>ADC group regular conversion trigger from external IP: external interrupt line 11. Trigger edge set to rising edge (default setting).</description>
                  <value>6</value>
                </enumeratedValue>
