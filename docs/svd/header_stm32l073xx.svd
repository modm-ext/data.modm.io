        </register>
        <register>
          <name>CHSELR</name>
          <description>ADC channel selection register</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <fields>
            <field>
              <name>CHSEL0</name>
              <description>Channel 0 selection</description>
              <bitOffset>0</bitOffset>
