                <enumeratedValue>
                  <name>SAMPLINGTIME_12CYCLES_5</name>
                  <description>Sampling time 12.5 ADC clock cycles</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAMPLINGTIME_19CYCLES_5</name>
                  <description>Sampling time 19.5 ADC clock cycles</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAMPLINGTIME_39CYCLES_5</name>
                  <description>Sampling time 39.5 ADC clock cycles</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAMPLINGTIME_79CYCLES_5</name>
                  <description>Sampling time 79.5 ADC clock cycles</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAMPLINGTIME_160CYCLES_5</name>
                  <description>Sampling time 160.5 ADC clock cycles</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TR</name>
          <description>ADC watchdog threshold register</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <fields>
            <field>
              <name>LT</name>
              <description>Analog watchdog low threshold</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>HT</name>
              <description>Analog watchdog high threshold</description>
              <bitOffset>16</bitOffset>
