      <name>ICACHE</name>
      <description>Instruction cache (ICACHE)</description>
      <groupName>ICACHE</groupName>
      <baseAddress>0x40030400</baseAddress>
      <interrupt>
        <name>ICACHE</name>
        <description>Instruction cache global interrupt</description>
        <value>14</value>
      </interrupt>
      <registers>
        <register>
          <name>CR</name>
