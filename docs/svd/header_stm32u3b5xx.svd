            <field>
              <name>CALOUT</name>
              <description>Operational amplifier calibration output</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HSM</name>
              <description>Operational amplifier high speed mode</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OPARANGE</name>
              <description>Operational amplifier range setting</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Power supply range low</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
