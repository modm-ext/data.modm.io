                  <name>GAIN_2</name>
                  <description>OPAMP PGA gain 2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GAIN_4</name>
                  <description>OPAMP PGA gain 4</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GAIN_8</name>
                  <description>OPAMP PGA gain 8</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GAIN_16</name>
                  <description>OPAMP PGA gain 16</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
