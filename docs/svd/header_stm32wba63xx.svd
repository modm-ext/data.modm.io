        <description>TIM1 Break interrupt</description>
        <value>37</value>
      </interrupt>
      <interrupt>
        <name>TIM1_UP</name>
        <description>TIM1 Update interrupt</description>
        <value>38</value>
      </interrupt>
      <interrupt>
