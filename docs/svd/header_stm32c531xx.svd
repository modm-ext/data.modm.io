              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFLUSH</name>
              <description>RX FIFO Flush</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXTHRES</name>
              <description>RX FIFO Threshold</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXDMAEN</name>
              <description>TX FIFO DMA mode Enable</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFLUSH</name>
              <description>TX FIFO Flush</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXTHRES</name>
