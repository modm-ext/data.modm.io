                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPTIM_TRIG_SOURCE_RTCALARMB</name>
                  <description>External input trigger is connected to RTC Alarm B</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPTIM_TRIG_SOURCE_RTCTAMP1</name>
                  <description>External input trigger is connected to RTC Tamper 1</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPTIM_TRIG_SOURCE_RTCTAMP2</name>
                  <description>External input trigger is connected to RTC Tamper 2</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPTIM_TRIG_SOURCE_RTCTAMP3</name>
                  <description>External input trigger is connected to RTC Tamper 3</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPTIM_TRIG_SOURCE_SAI1_FS_B</name>
