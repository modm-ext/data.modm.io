                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALLING</name>
                  <description>RTC_TS input falling edge generates a time-stamp even</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
