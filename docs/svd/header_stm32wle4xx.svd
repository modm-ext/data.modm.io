                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALLING</name>
                  <description>LPTIM counter starts when a falling edge is detected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
